import platform

from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.gridlayout import GridLayout
from kivy.uix.floatlayout import FloatLayout
from kivy.uix.anchorlayout import AnchorLayout
from kivy.uix.stacklayout import StackLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.togglebutton import ToggleButton
from kivy.uix.textinput import TextInput
from kivy.uix.codeinput import CodeInput
from kivy.uix.image import Image, AsyncImage
from kivy.uix.checkbox import CheckBox
from kivy.uix.switch import Switch
from kivy.uix.slider import Slider
from kivy.uix.progressbar import ProgressBar
from kivy.uix.scrollview import ScrollView
from kivy.uix.tabbedpanel import TabbedPanel, TabbedPanelItem
from kivy.uix.popup import Popup
from kivy.uix.modalview import ModalView
from kivy.uix.spinner import Spinner
from kivy.uix.dropdown import DropDown
from kivy.uix.actionbar import (
    ActionBar, ActionView, ActionPrevious,
    ActionButton, ActionOverflow, ActionGroup,
)
from kivy.uix.carousel import Carousel
from kivy.uix.screenmanager import (
    ScreenManager, Screen, SlideTransition,
)
from kivy.uix.filechooser import FileChooserIconView, FileChooserListView
from kivy.uix.treeview import TreeView, TreeViewLabel
from kivy.uix.colorpicker import ColorPicker
from kivy.uix.scatter import Scatter
from kivy.uix.videoplayer import VideoPlayer
from kivy.uix.camera import Camera
from kivy.uix.bubble import Bubble, BubbleButton
from kivy.uix.stencilview import StencilView
from kivy.uix.recycleview import RecycleView
from kivy.uix.recycleboxlayout import RecycleBoxLayout
from kivy.uix.recycleview.views import RecycleDataViewBehavior
from kivy.graphics import Color as GfxColor, Rectangle
from kivy.core.window import Window


# ── 한글 폰트 경로 (환경에 맞게 수정) ─────────────────────────────────────
FONT_PATH = {
    "Windows": "C:/Windows/Fonts/malgun.ttf",
    "Darwin": "/System/Library/Fonts/AppleSDGothicNeo.ttc",
}.get(platform.system(), "/usr/share/fonts/truetype/nanum/NanumGothic.ttf")

Window.size = (400, 600)


# ==============================================================================
# 1. 버튼 & 토글 버튼
# ==============================================================================
class Example1App(App):
    """Button, ToggleButton 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", spacing=10, padding=20)

        # 일반 버튼
        btn = Button(
            text="클릭하세요",
            font_name=FONT_PATH,
            font_size=20,
            size_hint=(1, 0.3),
            background_color=(0.2, 0.6, 1, 1),
        )
        btn.bind(on_press=lambda x: print("버튼 눌림!"))
        layout.add_widget(btn)

        # 토글 버튼 (on/off)
        toggle = ToggleButton(
            text="토글: 꺼짐",
            font_name=FONT_PATH,
            font_size=18,
            size_hint=(1, 0.3),
        )

        def on_toggle(instance):
            instance.text = "토글: 켜짐" if instance.state == "down" else "토글: 꺼짐"

        toggle.bind(state=on_toggle)
        layout.add_widget(toggle)

        # 토글 버튼 그룹 (라디오 버튼처럼 하나만 선택)
        group_layout = BoxLayout(spacing=5)
        for color in ["빨강", "초록", "파랑"]:
            tb = ToggleButton(
                text=color,
                font_name=FONT_PATH,
                group="colors",
                font_size=16,
            )
            tb.bind(on_press=lambda x, c=color: print(f"선택: {c}"))
            group_layout.add_widget(tb)
        layout.add_widget(group_layout)

        return layout


# ==============================================================================
# 2. 텍스트 입력 & 코드 입력
# ==============================================================================
class Example2App(App):
    """TextInput, CodeInput 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", spacing=10, padding=20)

        # 한 줄 입력
        single = TextInput(
            hint_text="이름을 입력하세요",
            multiline=False,
            size_hint=(1, 0.15),
            font_size=18,
        )
        single.bind(on_text_validate=lambda x: print(f"입력: {x.text}"))
        layout.add_widget(single)

        # 비밀번호 입력
        pwd = TextInput(
            hint_text="비밀번호",
            password=True,
            multiline=False,
            size_hint=(1, 0.15),
        )
        layout.add_widget(pwd)

        # 숫자만 입력
        num = TextInput(
            hint_text="숫자만 입력",
            input_filter="int",
            multiline=False,
            size_hint=(1, 0.15),
        )
        layout.add_widget(num)

        # 여러 줄 입력
        multi = TextInput(
            hint_text="여러 줄 입력 가능",
            multiline=True,
            size_hint=(1, 0.3),
        )
        layout.add_widget(multi)

        # 코드 입력
        code = CodeInput(
            text='print("Hello, Kivy!")',
            size_hint=(1, 0.25),
            font_size=14,
        )
        layout.add_widget(code)

        return layout


# ==============================================================================
# 3. 라벨 & 이미지
# ==============================================================================
class Example3App(App):
    """Label, Image, AsyncImage 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", spacing=10, padding=20)

        # 기본 라벨
        layout.add_widget(Label(
            text="기본 라벨",
            font_name=FONT_PATH,
            font_size=24,
            size_hint=(1, 0.2),
        ))

        # 마크업 라벨
        layout.add_widget(Label(
            text="[b]굵게[/b] [i]기울임[/i] [color=ff0000]빨강[/color] [size=20]크게[/size]",
            font_name=FONT_PATH,
            markup=True,
            size_hint=(1, 0.2),
        ))

        # 줄바꿈 라벨
        layout.add_widget(Label(
            text="이 텍스트는 자동으로 줄바꿈됩니다. 긴 텍스트도 잘 표시됩니다.",
            font_name=FONT_PATH,
            font_size=16,
            text_size=(None, None),
            halign="center",
            valign="middle",
            size_hint=(1, 0.2),
        ))

        # 비동기 이미지 (URL)
        layout.add_widget(AsyncImage(
            source="https://kivy.org/logos/kivy_logo_black_256.png",
            size_hint=(1, 0.4),
            allow_stretch=True,
            keep_ratio=True,
        ))

        return layout


# ==============================================================================
# 4. 체크박스 & 스위치
# ==============================================================================
class Example4App(App):
    """CheckBox, Switch 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", spacing=15, padding=20)

        # 체크박스 (다중 선택)
        layout.add_widget(Label(
            text="[ 다중 선택 체크박스 ]",
            font_name=FONT_PATH, font_size=20, size_hint=(1, 0.1),
        ))

        check_layout = GridLayout(cols=2, spacing=5)
        for item in ["피자", "치킨", "햄버거", "라면"]:
            row = BoxLayout(spacing=5)
            cb = CheckBox(active=False)
            cb.bind(active=lambda inst, val, i=item: print(f"{i}: {val}"))
            row.add_widget(cb)
            row.add_widget(Label(text=item, font_name=FONT_PATH, font_size=16))
            check_layout.add_widget(row)
        layout.add_widget(check_layout)

        # 체크박스 (라디오 - 하나만 선택)
        layout.add_widget(Label(
            text="[ 라디오 체크박스 (하나만) ]",
            font_name=FONT_PATH, font_size=20, size_hint=(1, 0.1),
        ))

        radio_layout = GridLayout(cols=2, spacing=5)
        for item in ["남성", "여성"]:
            row = BoxLayout(spacing=5)
            cb = CheckBox(group="gender")
            cb.bind(active=lambda inst, val, i=item: print(f"선택: {i}") if val else None)
            row.add_widget(cb)
            row.add_widget(Label(text=item, font_name=FONT_PATH, font_size=16))
            radio_layout.add_widget(row)
        layout.add_widget(radio_layout)

        # 스위치
        layout.add_widget(Label(
            text="[ 스위치 ]",
            font_name=FONT_PATH, font_size=20, size_hint=(1, 0.1),
        ))

        switch_layout = BoxLayout(spacing=10)
        for item in ["WiFi", "블루투스", "비행기모드"]:
            row = BoxLayout(spacing=5)
            sw = Switch(active=False)
            sw.bind(active=lambda inst, val, i=item: print(f"{i}: {'ON' if val else 'OFF'}"))
            row.add_widget(Label(text=item, font_name=FONT_PATH, font_size=14))
            row.add_widget(sw)
            switch_layout.add_widget(row)
        layout.add_widget(switch_layout)

        return layout


# ==============================================================================
# 5. 슬라이더 & 프로그레스 바
# ==============================================================================
class Example5App(App):
    """Slider, ProgressBar 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", spacing=20, padding=20)

        # 슬라이더
        slider_label = Label(text="볼륨: 50", font_name=FONT_PATH, font_size=20, size_hint=(1, 0.1))
        layout.add_widget(slider_label)

        slider = Slider(min=0, max=100, value=50, orientation="horizontal", size_hint=(1, 0.2))

        def on_slider(instance, value):
            slider_label.text = f"볼륨: {int(value)}"

        slider.bind(value=on_slider)
        layout.add_widget(slider)

        # 수직 슬라이더
        h_layout = BoxLayout(spacing=20)
        v_label = Label(text="밝기: 70", font_name=FONT_PATH, font_size=16, size_hint=(0.7, 0.3))
        v_slider = Slider(min=0, max=100, value=70, orientation="vertical", size_hint=(0.3, 0.3))
        v_slider.bind(value=lambda inst, v: setattr(v_label, "text", f"밝기: {int(v)}"))
        h_layout.add_widget(v_label)
        h_layout.add_widget(v_slider)
        layout.add_widget(h_layout)

        # 프로그레스 바
        layout.add_widget(Label(text="다운로드 진행률", font_name=FONT_PATH, font_size=18, size_hint=(1, 0.1)))
        pb = ProgressBar(max=100, value=30, size_hint=(1, 0.15))
        layout.add_widget(pb)

        # 프로그레스 바 조절 슬라이더
        ctrl = Slider(min=0, max=100, value=30, size_hint=(1, 0.15))
        ctrl.bind(value=lambda inst, v: setattr(pb, "value", v))
        layout.add_widget(ctrl)

        return layout


# ==============================================================================
# 6. 스크롤 뷰
# ==============================================================================
class Example6App(App):
    """ScrollView 예제"""

    def build(self):
        scroll = ScrollView(
            size_hint=(1, 1),
            bar_width="10dp",
            scroll_type=["content", "bars"],
        )

        content = BoxLayout(orientation="vertical", spacing=10, padding=10, size_hint_y=None)
        content.bind(minimum_height=content.setter("height"))

        for i in range(1, 51):
            btn = Button(
                text=f"항목 {i}",
                font_name=FONT_PATH,
                font_size=16,
                size_hint=(1, None),
                height="50dp",
            )
            btn.bind(on_press=lambda x, n=i: print(f"항목 {n} 클릭"))
            content.add_widget(btn)

        scroll.add_widget(content)
        return scroll


# ==============================================================================
# 7. 레이아웃 모음
# ==============================================================================
class Example7App(App):
    """BoxLayout, GridLayout, FloatLayout, AnchorLayout, StackLayout 예제"""

    def build(self):
        panel = TabbedPanel()

        # ── BoxLayout 탭 ──
        tab1 = TabbedPanelItem(text="BoxLayout")
        box = BoxLayout(orientation="vertical", spacing=5, padding=10)
        box.add_widget(Label(text="세로 BoxLayout", font_name=FONT_PATH, font_size=16))
        h_box = BoxLayout(spacing=5)
        for c, color in [("A", (1, .3, .3, 1)), ("B", (.3, 1, .3, 1)), ("C", (.3, .3, 1, 1))]:
            h_box.add_widget(Button(text=c, background_color=color))
        box.add_widget(h_box)
        tab1.add_widget(box)
        panel.add_widget(tab1)

        # ── GridLayout 탭 ──
        tab2 = TabbedPanelItem(text="GridLayout")
        grid = GridLayout(cols=3, spacing=5, padding=10)
        for i in range(1, 10):
            grid.add_widget(Button(text=str(i), font_size=24))
        tab2.add_widget(grid)
        panel.add_widget(tab2)

        # ── FloatLayout 탭 ──
        tab3 = TabbedPanelItem(text="FloatLayout")
        fl = FloatLayout()
        fl.add_widget(Button(text="좌상", pos_hint={"x": 0.05, "top": 0.95}, size_hint=(0.3, 0.2)))
        fl.add_widget(Button(text="중앙", pos_hint={"center_x": 0.5, "center_y": 0.5}, size_hint=(0.3, 0.2)))
        fl.add_widget(Button(text="우하", pos_hint={"right": 0.95, "y": 0.05}, size_hint=(0.3, 0.2)))
        tab3.add_widget(fl)
        panel.add_widget(tab3)

        # ── AnchorLayout 탭 ──
        tab4 = TabbedPanelItem(text="AnchorLayout")
        al = AnchorLayout(anchor_x="center", anchor_y="top")
        al.add_widget(Button(text="상단 중앙", size_hint=(0.5, 0.2)))
        tab4.add_widget(al)
        panel.add_widget(tab4)

        # ── StackLayout 탭 ──
        tab5 = TabbedPanelItem(text="StackLayout")
        stack = StackLayout(orientation="lr-tb", spacing=5, padding=10)
        for i in range(1, 21):
            stack.add_widget(Button(text=str(i), size_hint=(0.2, 0.15)))
        tab5.add_widget(stack)
        panel.add_widget(tab5)

        return panel


# ==============================================================================
# 8. 탭 패널
# ==============================================================================
class Example8App(App):
    """TabbedPanel, TabbedPanelItem 예제"""

    def build(self):
        panel = TabbedPanel(tab_pos="top_left", tab_height="40dp")

        tabs = [
            ("홈", "🏠 홈 화면입니다"),
            ("검색", "🔍 검색 화면입니다"),
            ("설정", "⚙️ 설정 화면입니다"),
            ("프로필", "👤 프로필 화면입니다"),
        ]

        for title, content in tabs:
            tab = TabbedPanelItem(text=title)
            tab.add_widget(Label(
                text=content,
                font_name=FONT_PATH,
                font_size=22,
                halign="center",
                valign="middle",
            ))
            panel.add_widget(tab)

        return panel


# ==============================================================================
# 9. 팝업 & 모달뷰
# ==============================================================================
class Example9App(App):
    """Popup, ModalView 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", spacing=15, padding=20)

        # 팝업 버튼
        popup_btn = Button(text="팝업 열기", font_name=FONT_PATH, font_size=20, size_hint=(1, 0.3))

        def show_popup(instance):
            content = BoxLayout(orientation="vertical", spacing=10, padding=10)
            content.add_widget(Label(text="이것은 팝업입니다!", font_name=FONT_PATH, font_size=18))
            close_btn = Button(text="닫기", font_name=FONT_PATH, size_hint=(1, 0.3))
            content.add_widget(close_btn)
            popup = Popup(
                title="알림",
                title_font=FONT_PATH,
                content=content,
                size_hint=(0.7, 0.4),
                auto_dismiss=True,
            )
            close_btn.bind(on_press=popup.dismiss)
            popup.open()

        popup_btn.bind(on_press=show_popup)
        layout.add_widget(popup_btn)

        # 모달뷰 버튼
        modal_btn = Button(text="모달뷰 열기", font_name=FONT_PATH, font_size=20, size_hint=(1, 0.3))

        def show_modal(instance):
            modal = ModalView(size_hint=(0.8, 0.5), auto_dismiss=True)
            inner = BoxLayout(orientation="vertical", spacing=10, padding=10)
            inner.add_widget(Label(text="모달뷰 내용", font_name=FONT_PATH, font_size=20))
            inner.add_widget(Label(text="배경을 클릭하면 닫힙니다", font_name=FONT_PATH, font_size=14))
            modal.add_widget(inner)
            modal.open()

        modal_btn.bind(on_press=show_modal)
        layout.add_widget(modal_btn)

        # 확인/취소 팝업
        confirm_btn = Button(text="확인 팝업", font_name=FONT_PATH, font_size=20, size_hint=(1, 0.3))

        def show_confirm(instance):
            content = BoxLayout(orientation="vertical", spacing=10)
            content.add_widget(Label(text="정말 삭제하시겠습니까?", font_name=FONT_PATH, font_size=18))
            btn_row = BoxLayout(spacing=10)
            yes = Button(text="예", font_name=FONT_PATH, background_color=(1, 0.3, 0.3, 1))
            no = Button(text="아니오", font_name=FONT_PATH)
            btn_row.add_widget(yes)
            btn_row.add_widget(no)
            content.add_widget(btn_row)

            popup = Popup(title="확인", title_font=FONT_PATH, content=content, size_hint=(0.7, 0.35))
            yes.bind(on_press=lambda x: (print("삭제 실행!"), popup.dismiss()))
            no.bind(on_press=popup.dismiss)
            popup.open()

        confirm_btn.bind(on_press=show_confirm)
        layout.add_widget(confirm_btn)

        return layout


# ==============================================================================
# 10. 스피너 (드롭다운 선택)
# ==============================================================================
class Example10App(App):
    """Spinner 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", spacing=15, padding=20)

        # 기본 스피너
        spinner_label = Label(text="선택된 항목: 없음", font_name=FONT_PATH, font_size=18, size_hint=(1, 0.15))
        layout.add_widget(spinner_label)

        spinner = Spinner(
            text="선택하세요",
            values=("서울", "부산", "대구", "인천", "광주", "대전", "울산"),
            font_name=FONT_PATH,
            font_size=18,
            size_hint=(1, 0.2),
            background_color=(0.3, 0.5, 0.8, 1),
        )

        def on_spinner_text(inst, val):
            spinner_label.text = f"선택된 항목: {val}"

        spinner.bind(text=on_spinner_text)
        layout.add_widget(spinner)

        # 숫자 스피너
        num_label = Label(text="인원 수: 1", font_name=FONT_PATH, font_size=18, size_hint=(1, 0.15))
        layout.add_widget(num_label)

        num_spinner = Spinner(
            text="1",
            values=tuple(str(i) for i in range(1, 11)),
            font_name=FONT_PATH,
            font_size=18,
            size_hint=(1, 0.2),
        )

        def on_num_text(inst, val):
            num_label.text = f"인원 수: {val}"

        num_spinner.bind(text=on_num_text)
        layout.add_widget(num_spinner)

        return layout


# ==============================================================================
# 11. 드롭다운 메뉴
# ==============================================================================
class Example11App(App):
    """DropDown 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", spacing=20, padding=20)

        # 드롭다운 생성
        dropdown = DropDown()
        items = ["새로 만들기", "열기", "저장", "다른 이름으로 저장", "인쇄"]
        for item in items:
            btn = Button(text=item, font_name=FONT_PATH, font_size=14, size_hint_y=None, height="40dp")
            btn.bind(on_release=lambda x, i=item: dropdown.select(i))
            dropdown.add_widget(btn)

        # 메인 버튼
        main_btn = Button(text="파일 메뉴 ▼", font_name=FONT_PATH, font_size=18, size_hint=(1, 0.3))
        main_btn.bind(on_release=dropdown.open)

        # 선택 결과
        result_label = Label(text="선택: 없음", font_name=FONT_PATH, font_size=18, size_hint=(1, 0.2))

        def on_select(instance, data):
            main_btn.text = data
            result_label.text = f"선택: {data}"

        dropdown.bind(on_select=on_select)

        layout.add_widget(main_btn)
        layout.add_widget(result_label)
        return layout


# ==============================================================================
# 12. 액션 바
# ==============================================================================
class Example12App(App):
    """ActionBar, ActionView, ActionPrevious, ActionButton, ActionOverflow, ActionGroup 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical")

        # 액션 바
        action_bar = ActionBar(pos_hint={"top": 1})
        action_view = ActionView()
        action_view.add_widget(ActionPrevious(
            title="내 앱",
            with_previous=False,
            app_icon="",
        ))

        # 액션 버튼들
        for name in ["검색", "추가", "편집"]:
            action_view.add_widget(ActionButton(
                text=name,
                important=True,
                on_press=lambda x, n=name: print(f"{n} 클릭"),
            ))

        # 오버플로우 (더 보기 메뉴)
        overflow = ActionOverflow()
        overflow.add_widget(ActionButton(text="설정", on_press=lambda x: print("설정")))
        overflow.add_widget(ActionButton(text="도움말", on_press=lambda x: print("도움말")))
        overflow.add_widget(ActionButton(text="정보", on_press=lambda x: print("정보")))
        action_view.add_widget(overflow)

        # 액션 그룹
        group = ActionGroup(text="공유")
        for name in ["이메일", "카카오톡", "문자"]:
            group.add_widget(ActionButton(
                text=name,
                on_press=lambda x, n=name: print(f"공유: {n}"),
            ))
        action_view.add_widget(group)

        action_bar.add_widget(action_view)
        layout.add_widget(action_bar)

        # 본문
        layout.add_widget(Label(text="액션 바 예제", font_name=FONT_PATH, font_size=24))

        return layout


# ==============================================================================
# 13. 캐러셀 (슬라이드 뷰)
# ==============================================================================
class Example13App(App):
    """Carousel 예제"""

    def build(self):
        carousel = Carousel(direction="right", loop=True)

        colors = [
            ("빨강 페이지", (1, 0.3, 0.3, 1)),
            ("초록 페이지", (0.3, 1, 0.3, 1)),
            ("파랑 페이지", (0.3, 0.3, 1, 1)),
            ("노랑 페이지", (1, 1, 0.3, 1)),
            ("보라 페이지", (0.7, 0.3, 1, 1)),
        ]

        for title, color in colors:
            slide = BoxLayout(orientation="vertical", padding=20)
            slide.add_widget(Label(text=title, font_name=FONT_PATH, font_size=32, color=(0, 0, 0, 1)))
            slide.add_widget(Label(text="← 스와이프 →", font_name=FONT_PATH, font_size=18, color=(0, 0, 0, 1)))

            # 배경색 canvas 설정
            with slide.canvas.before:
                GfxColor(*color)
                rect = Rectangle(pos=slide.pos, size=slide.size)
                slide.bind(
                    pos=lambda inst, v, r=rect: setattr(r, "pos", v),
                    size=lambda inst, v, r=rect: setattr(r, "size", v),
                )
            carousel.add_widget(slide)

        return carousel


# ==============================================================================
# 14. 화면 관리자 (ScreenManager)
# ==============================================================================
class Example14App(App):
    """ScreenManager, Screen, SlideTransition 예제"""

    def build(self):
        sm = ScreenManager(transition=SlideTransition())

        # 화면 1 - 로그인
        screen1 = Screen(name="login")
        s1_layout = BoxLayout(orientation="vertical", spacing=15, padding=30)
        s1_layout.add_widget(Label(text="로그인 화면", font_name=FONT_PATH, font_size=28, size_hint=(1, 0.3)))
        s1_layout.add_widget(TextInput(hint_text="아이디", multiline=False, size_hint=(1, 0.15)))
        s1_layout.add_widget(TextInput(hint_text="비밀번호", password=True, multiline=False, size_hint=(1, 0.15)))
        go_main = Button(text="로그인 →", font_name=FONT_PATH, size_hint=(1, 0.2))
        go_main.bind(on_press=lambda x: setattr(sm, "current", "main"))
        s1_layout.add_widget(go_main)
        screen1.add_widget(s1_layout)
        sm.add_widget(screen1)

        # 화면 2 - 메인
        screen2 = Screen(name="main")
        s2_layout = BoxLayout(orientation="vertical", spacing=15, padding=30)
        s2_layout.add_widget(Label(text="메인 화면", font_name=FONT_PATH, font_size=28, size_hint=(1, 0.2)))
        s2_layout.add_widget(Label(text="환영합니다!", font_name=FONT_PATH, font_size=20, size_hint=(1, 0.2)))
        btn_row = BoxLayout(spacing=10)
        go_setting = Button(text="설정 →", font_name=FONT_PATH)
        go_setting.bind(on_press=lambda x: setattr(sm, "current", "settings"))
        go_back = Button(text="← 로그인", font_name=FONT_PATH)
        go_back.bind(on_press=lambda x: setattr(sm, "current", "login"))
        btn_row.add_widget(go_setting)
        btn_row.add_widget(go_back)
        s2_layout.add_widget(btn_row)
        screen2.add_widget(s2_layout)
        sm.add_widget(screen2)

        # 화면 3 - 설정
        screen3 = Screen(name="settings")
        s3_layout = BoxLayout(orientation="vertical", spacing=15, padding=30)
        s3_layout.add_widget(Label(text="설정 화면", font_name=FONT_PATH, font_size=28, size_hint=(1, 0.3)))
        go_back2 = Button(text="← 메인", font_name=FONT_PATH, size_hint=(1, 0.2))
        go_back2.bind(on_press=lambda x: setattr(sm, "current", "main"))
        s3_layout.add_widget(go_back2)
        screen3.add_widget(s3_layout)
        sm.add_widget(screen3)

        return sm


# ==============================================================================
# 15. 파일 선택기
# ==============================================================================
class Example15App(App):
    """FileChooserIconView, FileChooserListView 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", spacing=10, padding=10)

        path_label = Label(text="선택된 파일: 없음", font_name=FONT_PATH, font_size=14, size_hint=(1, 0.1))
        layout.add_widget(path_label)

        panel = TabbedPanel()

        # 아이콘 뷰
        tab_icon = TabbedPanelItem(text="아이콘 뷰")
        icon_view = FileChooserIconView(path=".", filters=["*.py", "*.txt", "*.png", "*.jpg"])

        def on_icon_select(inst, sel):
            path_label.text = f"선택: {sel[0]}" if sel else "선택된 파일: 없음"

        icon_view.bind(selection=on_icon_select)
        tab_icon.add_widget(icon_view)
        panel.add_widget(tab_icon)

        # 리스트 뷰
        tab_list = TabbedPanelItem(text="리스트 뷰")
        list_view = FileChooserListView(path=".")

        def on_list_select(inst, sel):
            path_label.text = f"선택: {sel[0]}" if sel else "선택된 파일: 없음"

        list_view.bind(selection=on_list_select)
        tab_list.add_widget(list_view)
        panel.add_widget(tab_list)

        layout.add_widget(panel)
        return layout


# ==============================================================================
# 16. 트리 뷰
# ==============================================================================
class Example16App(App):
    """TreeView, TreeViewLabel 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", padding=20, spacing=10)

        tv = TreeView(hide_root=False, size_hint=(1, 1))

        root = tv.add_node(TreeViewLabel(text="프로젝트", font_name=FONT_PATH, is_open=True))

        src = tv.add_node(TreeViewLabel(text="src", font_name=FONT_PATH, is_open=True), root)
        tv.add_node(TreeViewLabel(text="main.py", font_name=FONT_PATH), src)
        tv.add_node(TreeViewLabel(text="app.py", font_name=FONT_PATH), src)
        tv.add_node(TreeViewLabel(text="utils.py", font_name=FONT_PATH), src)

        res = tv.add_node(TreeViewLabel(text="resources", font_name=FONT_PATH, is_open=True), root)
        img = tv.add_node(TreeViewLabel(text="images", font_name=FONT_PATH, is_open=True), res)
        tv.add_node(TreeViewLabel(text="logo.png", font_name=FONT_PATH), img)
        tv.add_node(TreeViewLabel(text="icon.png", font_name=FONT_PATH), img)
        fonts = tv.add_node(TreeViewLabel(text="fonts", font_name=FONT_PATH), res)
        tv.add_node(TreeViewLabel(text="malgun.ttf", font_name=FONT_PATH), fonts)

        config = tv.add_node(TreeViewLabel(text="config", font_name=FONT_PATH), root)
        tv.add_node(TreeViewLabel(text="settings.json", font_name=FONT_PATH), config)

        layout.add_widget(tv)
        return layout


# ==============================================================================
# 17. 색상 선택기
# ==============================================================================
class Example17App(App):
    """ColorPicker 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", spacing=15, padding=20)

        color_label = Label(text="RGB: (1.00, 1.00, 1.00)", font_name=FONT_PATH, font_size=18, size_hint=(1, 0.15))
        layout.add_widget(color_label)

        # 색상 미리보기
        preview = FloatLayout(size_hint=(1, 0.2))
        with preview.canvas:
            c = GfxColor(1, 1, 1, 1)
            r = Rectangle(pos=preview.pos, size=preview.size)
            preview.bind(
                pos=lambda inst, v, r=r: setattr(r, "pos", v),
                size=lambda inst, v, r=r: setattr(r, "size", v),
            )

        picker = ColorPicker(size_hint=(1, 0.55))

        def on_color(instance, value):
            c.r, c.g, c.b, c.a = value
            color_label.text = f"RGB: ({value[0]:.2f}, {value[1]:.2f}, {value[2]:.2f})"

        picker.bind(color=on_color)

        layout.add_widget(preview)
        layout.add_widget(picker)
        layout.add_widget(color_label)
        return layout


# ==============================================================================
# 18. 스캐터 (드래그/줌)
# ==============================================================================
class Example18App(App):
    """Scatter 예제 (드래그/핀치줌/회전)"""

    def build(self):
        root = FloatLayout()

        scatter = Scatter(
            pos_hint={"center_x": 0.5, "center_y": 0.5},
            size_hint=(None, None),
            size=(200, 200),
            do_translation=True,
            do_rotation=True,
            do_scale=True,
            auto_bring_to_front=True,
        )
        img = AsyncImage(
            source="https://kivy.org/logos/kivy_logo_black_256.png",
            allow_stretch=True,
            keep_ratio=True,
        )
        scatter.add_widget(img)
        root.add_widget(scatter)

        root.add_widget(Label(
            text="이미지를 드래그/핀치줌/회전하세요",
            font_name=FONT_PATH, font_size=14,
            pos_hint={"top": 1}, size_hint=(1, 0.08),
        ))

        return root


# ==============================================================================
# 19. 비디오 & 카메라
# ==============================================================================
class Example19App(App):
    """VideoPlayer, Camera 예제"""

    def build(self):
        panel = TabbedPanel()

        # 비디오 플레이어 탭
        tab1 = TabbedPanelItem(text="비디오")
        v_layout = BoxLayout(orientation="vertical", spacing=10, padding=10)
        v_layout.add_widget(Label(
            text="비디오 플레이어 예제\n(로컬 비디오 파일이 필요합니다)",
            font_name=FONT_PATH, font_size=16, size_hint=(1, 0.3),
        ))
        # 실제 파일 경로로 변경:
        # v_layout.add_widget(VideoPlayer(source="video.mp4", state="play"))
        tab1.add_widget(v_layout)
        panel.add_widget(tab1)

        # 카메라 탭
        tab2 = TabbedPanelItem(text="카메라")
        cam_layout = BoxLayout(orientation="vertical", spacing=10, padding=10)
        try:
            cam = Camera(play=True, resolution=(640, 480), size_hint=(1, 0.8))
            cam_layout.add_widget(cam)
        except Exception:
            cam_layout.add_widget(Label(text="카메라를 사용할 수 없습니다", font_name=FONT_PATH, font_size=18))
        tab2.add_widget(cam_layout)
        panel.add_widget(tab2)

        return panel


# ==============================================================================
# 20. 말풍선 (Bubble)
# ==============================================================================
class Example20App(App):
    """Bubble, BubbleButton 예제"""

    def build(self):
        root = FloatLayout()

        # 말풍선
        bubble = Bubble(
            size_hint=(None, None),
            size=(250, 80),
            pos_hint={"center_x": 0.5, "center_y": 0.6},
            arrow_pos="bottom_mid",
            show_arrow=True,
        )
        for action in ["복사", "잘라내기", "붙여넣기"]:
            bubble.add_widget(BubbleButton(
                text=action, font_name=FONT_PATH, font_size=14,
                on_press=lambda x, a=action: print(f"{a} 클릭"),
            ))
        root.add_widget(bubble)

        # 다양한 화살표 위치
        for i, pos in enumerate(["left_mid", "top_mid", "right_mid"]):
            b = Bubble(size_hint=(None, None), size=(120, 50), arrow_pos=pos,
                       pos_hint={"x": 0.1 + i * 0.3, "y": 0.15})
            b.add_widget(BubbleButton(text=pos, font_size=10))
            root.add_widget(b)

        root.add_widget(Label(
            text="말풍선(Bubble) 예제",
            font_name=FONT_PATH, font_size=18,
            pos_hint={"top": 1}, size_hint=(1, 0.08),
        ))

        return root


# ==============================================================================
# 21. 스텐실 뷰 (마스킹)
# ==============================================================================
class Example21App(App):
    """StencilView 예제"""

    def build(self):
        layout = BoxLayout(orientation="vertical", spacing=10, padding=20)

        layout.add_widget(Label(
            text="스텐실 뷰: 150x150 영역만 표시",
            font_name=FONT_PATH, font_size=16, size_hint=(1, 0.1),
        ))

        fl = FloatLayout()
        stencil = StencilView(
            size_hint=(None, None),
            size=(150, 150),
            pos_hint={"center_x": 0.5, "center_y": 0.5},
        )
        big_label = Label(
            text="A B C D E F G H I J K L M N O P",
            font_size=30,
            size_hint=(None, None),
            size=(400, 400),
        )
        stencil.add_widget(big_label)
        fl.add_widget(stencil)
        layout.add_widget(fl)

        return layout


# ==============================================================================
# 22. RecycleView (대량 데이터 리스트)
# ==============================================================================
class SelectableLabel(RecycleDataViewBehavior, Label):
    """RecycleView에서 사용할 선택 가능 라벨"""
    font_name = FONT_PATH

    def on_touch_down(self, touch):
        if self.collide_point(*touch.pos):
            print(f"선택: {self.text}")
            return True
        return super().on_touch_down(touch)


class Example22App(App):
    """RecycleView 예제"""

    def build(self):
        rv = RecycleView(
            viewclass=SelectableLabel,
            size_hint=(1, 1),
            bar_width="10dp",
        )

        layout = RecycleBoxLayout(
            orientation="vertical",
            spacing="5dp",
            default_size=(None, "40dp"),
            default_size_hint=(1, None),
            size_hint_y=None,
        )
        layout.bind(minimum_height=layout.setter("height"))
        rv.layout_manager = layout

        rv.data = [{"text": f"항목 {i}: 데이터 예제 {i * 100}"} for i in range(100)]

        return rv


